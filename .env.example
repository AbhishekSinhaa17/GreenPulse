# ==============================================================================
# GreenPulse — Environment Configuration Template
# NOTE: Only public, client-safe variables prefixed with VITE_ are permitted here.
# NEVER expose Supabase service-role keys or Stripe secret keys in frontend code.
# ==============================================================================

# Supabase Public API Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# Stripe Public Key
VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_publishable_key

# Public Application Root URL
VITE_APP_URL=http://localhost:5173
